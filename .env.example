# =====================================================================
# Forest Production Bridge — environment variables (Netlify)
# Copy to Netlify dashboard (Site settings → Environment variables)
# =====================================================================

# ---- Supabase (new project) ----
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...   # service_role key — server only

# ---- Auth ----
# Users and passwords live in the `users` table (migration 0048), NOT here.
# Create the first admin from the Supabase SQL Editor:
#   INSERT INTO users (username, full_name, password_hash, role)
#   VALUES ('elias', 'Elias Bayter',
#           crypt('the-password', gen_salt('bf', 12)), 'admin');
# Everyone else is managed from /admin/config.
#
# LEGACY (bootstrap only): while no active user exists, login falls back to
# these per-role hashes, using the role name as the username. Leave blank
# once the first user is created.
# Generate with:  node scripts/hash-password.js "the-password"
FOREST_PASSWORD_HASH=
FINCA_PASSWORD_HASH=
ADMIN_PASSWORD_HASH=

# Random secret for HMAC-signed session cookies (>= 32 chars).
# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# ---- Gmail API (reuse Forest OAuth refresh token) ----
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_FROM_ADDRESS=Forest Production Bridge <noreply@forest.example>

# Set to "false" to actually send emails. Defaults to dry-run.
EMAIL_DRY_RUN=true

# ---- Notification recipients (comma-separated) ----
EMAIL_RECIPIENTS_DEMAND_CREATOR=person1@forest.example,person2@forest.example
EMAIL_RECIPIENTS_FARM=farm1@elvergel.example,farm2@elvergel.example
EMAIL_RECIPIENTS_ADMIN=admin1@forest.example,admin2@forest.example

# ---- Misc ----
NODE_ENV=production
